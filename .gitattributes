# Repository text is normalized to LF so release bytes are identical on every
# checkout platform, including PowerShell scripts. Line-ending variants in a
# checked-out tree must never change published artifact bytes.
* text eol=lf

*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
